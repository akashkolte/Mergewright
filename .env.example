# Copy to .env and fill in. Never commit .env.
# Needed only for live mode. Replay mode and the tests need no model, key or network.
# Live mode speaks one of two wire formats (MERGEWRIGHT_API_STYLE):
#   openai            any OpenAI-compatible chat server (POST <base URL>/chat/completions):
#                     NVIDIA NIM, vLLM, OpenAI, Bedrock Mantle for non-Anthropic models.
#   bedrock-converse  Amazon Bedrock Runtime's Converse API (POST <base URL>/model/<id>/converse):
#                     every Bedrock model, Anthropic's included; the key is a Bedrock API key.
MERGEWRIGHT_API_STYLE=openai

# Model name exactly as the server lists it, for example moonshotai/kimi-k3.1-pro, or for
# bedrock-converse an inference profile such as us.anthropic.claude-sonnet-4-6.
MERGEWRIGHT_MODEL=

# Base URL of the server: usually ending in /v1 for openai; for bedrock-converse, for example
# https://bedrock-runtime.us-east-1.amazonaws.com
MERGEWRIGHT_API_BASE=

# API key for that server. If the server needs no key, leave it empty.
MERGEWRIGHT_API_KEY=

# Optional: the price in US$ per million input and output tokens, for the cost in eval results.
# Without it, a live eval records the cost as unknown (null), never as a guess.
MERGEWRIGHT_PRICE_IN_PER_MTOK=
MERGEWRIGHT_PRICE_OUT_PER_MTOK=
