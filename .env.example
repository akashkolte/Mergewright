# Copy to .env and fill in. Never commit .env.
# Needed only for live mode. Replay mode and the tests need no model, key or network.

# LiteLLM model string. For an OpenAI-compatible server (such as the UB-hosted model),
# use openai/<model name exactly as the server lists it>, for example openai/GLM-5.2.
MERGEWRIGHT_MODEL=

# Base URL of the OpenAI-compatible server, usually ending in /v1.
# Leave empty for a hosted provider that LiteLLM knows (anthropic/..., openai/...).
MERGEWRIGHT_API_BASE=

# API key for that server. If the server needs no key, set any non-empty placeholder.
MERGEWRIGHT_API_KEY=
