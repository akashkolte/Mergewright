+    @staticmethod
+    def _get_sql_exts(
+        default_exts: Tuple[str, ...] = (".sql",),
+        config: Optional[FluffConfig] = None,
+    ) -> Tuple[str, ...]:
+        """Get the file extensions to lint, from config or defaults.
+
+        The `sql_file_exts` config value is a comma separated list of
+        file extensions (each of which should start with a dot), which
+        are treated as sql files when searching for files to lint.
+        """
+        exts = config.get("sql_file_exts", default=None) if config else None
+        if not exts:
+            return default_exts
+        # Split on commas (or accept an iterable) and normalise each
+        # extension so that it starts with a dot.
+        if isinstance(exts, str):
+            raw_exts: Iterable[str] = exts.split(",")
+        else:
+            raw_exts = exts
+        parsed = tuple(
+            sorted(
+                {
+                    ext if ext.startswith(".") else "." + ext
+                    for ext in (e.strip() for e in raw_exts)
+                    if ext
+                }
+            )
+        )
+        return parsed or default_exts
+
     def rule_tuples(self) -> List[RuleTuple]:
         """A simple pass through to access the rule tuples of the rule set."""
         rs = self.get_ruleset()
