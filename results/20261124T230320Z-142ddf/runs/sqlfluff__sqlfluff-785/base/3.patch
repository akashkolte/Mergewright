+[sqlfluff]
+verbose = 0
+nocolor = False
+dialect = ansi
+templater = jinja
+rules = None
+exclude_rules = None
+recurse = 0
+output_line_length = 80
+runaway_limit = 10
+ignore_templated_areas = True
+# Config to control which file extensions are treated as sql files
+sql_file_exts = None
+
+[sqlfluff:indentation]
+indented_joins = False
+template_blocks_indent = True
