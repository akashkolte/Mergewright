+                ("NUMBER", "1", 4),
+            ],
+        ),
+        (
+            "36+2>>3",
+            [
+                ("NUMBER", "36", 0),
+                ("PLUS", "+", 2),
+                ("NUMBER", "2", 3),
+                ("RSHIFT", ">>", 4),
+                ("NUMBER", "3", 6),
+            ],
+        ),
+    ],
+)
+def test_pymode_not_ioredirect(s, exp):
+    # test that Python code like `2>1` is lexed correctly
